{
  "info": {
    "name": "Programación BE II - Plataforma de Eventos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"first_name\":\"Laura\",\"last_name\":\"Castro\",\"email\":\"laura@example.com\",\"age\":29,\"password\":\"Clave123!\"}"
            },
            "url": "{{baseUrl}}/sessions/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "if (json.payload?._id) pm.collectionVariables.set('userId', json.payload._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"laura@example.com\",\"password\":\"Clave123!\"}"
            },
            "url": "{{baseUrl}}/sessions/login"
          }
        },
        {
          "name": "Current",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/sessions/current"
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events"
          }
        },
        {
          "name": "Create event (organizer/admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.payload?._id) pm.collectionVariables.set('eventId', json.payload._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Workshop de Backend\",\"description\":\"Workshop práctico sobre APIs y arquitectura backend.\",\"date\":\"2027-03-15T19:00:00.000Z\",\"location\":\"Buenos Aires\",\"capacity\":50}"
            },
            "url": "{{baseUrl}}/events"
          }
        },
        {
          "name": "Get event",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/{{eventId}}"
          }
        },
        {
          "name": "Register ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.payload?._id) pm.collectionVariables.set('ticketId', json.payload._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/events/{{eventId}}/tickets"
          }
        },
        {
          "name": "My tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/tickets/mine"
          }
        },
        {
          "name": "Cancel ticket",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/tickets/{{ticketId}}/cancel"
          }
        }
      ]
    }
  ]
}
